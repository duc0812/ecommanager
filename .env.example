SHOPIFY_SHOP_DOMAIN=your-store.myshopify.com
SHOPIFY_ACCESS_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxx
SHOPIFY_API_VERSION=2024-04
AUTH_SECRET=your-32-char-random-secret
DATABASE_URL=file:./dev.db

# Meta insights first-sync floor (YYYY-MM-DD). Defaults: account level 730 days back, campaign level 180 days back.
# META_INSIGHTS_FIRST_SYNC_SINCE=
# META_CAMPAIGN_INSIGHTS_FIRST_SYNC_SINCE=

# Customer Service module (optional fallbacks; the Cài đặt CS page stores these in the DB)
# FRESHDESK_API_KEY=
# FRESHDESK_DOMAIN=litzzy
# ANTHROPIC_API_KEY=
# KIE_API_KEY=            # Claude via api.kie.ai (default provider in Cài đặt CS)
# Telegram alerts reuse TELEGRAM_BOT_TOKEN / TELEGRAM_CHAT_ID (or the Tools → Resources config)
